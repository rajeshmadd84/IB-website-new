7:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does it replace my procurement team?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It removes the busywork. Buyers set strategy, mandates and approvals; the agents handle RFQ drafting, parsing, scoring and negotiation logistics, so the team spends time on judgement, not data entry.\"}},{\"@type\":\"Question\",\"name\":\"How are suppliers scored?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On a configurable blend of commercial terms (price, lead time, warranty) and a supplier scorecard covering ESG, financial health and past performance. You control the weighting, and every score is explainable.\"}},{\"@type\":\"Question\",\"name\":\"Where do pilots begin?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"From your BoMs. BIM-native ingestion comes later; sourcing starts from the bill of materials and project specs you already have.\"}}]}"}}],["$","section",null,{"className":"ib-phero","children":[["$","div",null,{"className":"ib-grid-bg"}],["$","div",null,{"className":"ib-wrap","style":{"position":"relative"},"children":[["$","span",null,{"className":"ib-eyebrow","children":[["$","svg",null,{"width":22,"height":22,"viewBox":"0 0 24 24","fill":"none","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","rect",null,{"x":"5","y":"8","width":"14","height":"11","rx":"3"}],["$","path",null,{"d":"M12 8V4M9 4h6"}],["$","circle",null,{"cx":"9.5","cy":"13","r":"1.2"}],["$","circle",null,{"cx":"14.5","cy":"13","r":"1.2"}],["$","path",null,{"d":"M2 13v3M22 13v3"}]]}]," ","Agentic AI · Team"]}],["$","h1",null,{"children":["The ",["$","span",null,{"style":{"color":"var(--ib-cyan)"},"children":"Procurement"}]," team"]}],["$","p",null,{"children":"Five agents that turn a material requirement into a conf