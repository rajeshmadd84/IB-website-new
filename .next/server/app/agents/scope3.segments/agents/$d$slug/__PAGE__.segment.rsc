0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does carbon tracking mean extra data entry?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The Scope 3 agents draw on the same RFQ, PO and shipment records the procurement agents already produce, so emissions are quantified automatically the moment an order is placed.\"}},{\"@type\":\"Question\",\"name\":\"Which frameworks are supported?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"CSRD ESRS E1, the GHG Protocol, CDP and ISSB IFRS S2, all generated from the same underlying ledger, so there's no recalculation between frameworks.\"}},{\"@type\":\"Question\",\"name\":\"How does data quality improve over time?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Spend-based and average factors are systematically replaced with primary supplier data (EPDs and verified product carbon footprints), moving figures from tier 3 toward tier 1, with every change logged.\"}}]}"}}],["$","section",null,{"className":"ib-phero","children":[["$","div",null,{"className":"ib-grid-bg"}],["$","div",null,{"className":"ib-wrap","style":{"position":"relative"},"children":[["$","span",null,{"className":"ib-eyebrow","children":[["$","svg",null,{"width":22,"height":22,"viewBox":"0 0 24 24","fill":"none","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","rect",null,{"x":"5","y":"8","width":"14","height":"11","rx":"3"}],["$","path",null,{"d":"M12 8V4M9 4h6"}],["$","circle",null,{"cx":"9.5","cy":"13","r":"1.2"}],["$","circle",null,{"cx":"14.5","cy":"13","r":"1.2"}],["$","path",null,{"d":"M2 13v3M22 13v3"}]]}]," ","Agentic AI · Team"]}],["$","h1",null,{"children":["The ",["$","span",null,{"style":{"color":"var(--ib-cyan)"},"children":"Scope 3"}]," team"]}],["$","p",null,{"children":"Six agents that quantify, disclose and reduce value-chain emissions by mapping every transaction to a GHG Protocol category, calculating CO₂e at the right data-quality tier, engaging suppliers for primary data, and generating audit-ready disclosures. Carbon becomes a real input to procurement, not a number reported six months late."}],["$","p",null,{"style":{"marginTop":"1.1rem","color":"var(--ib-text-muted)","fontSize":"1rem","maxWidth":"660px"},"children":"The Scope 3 agents share data with the procurement team, drawing on the same RFQ, supplier and shipment records, so emissions are calculated the moment an order is placed, with no separate carbon data entry."}]]}]]}],["$","section",null,{"className":"ib-sec","children":["$","div",null,{"className":"ib-wrap","children":[["$","div",null,{"className":"ib-head ib-reveal","children":[["$","span",null,{"className":"ib-eyebrow","children":[["$","svg",null,{"width":22,"height":22,"viewBox":"0 0 24 24","fill":"none","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","circle",null,{"cx":"12","cy":"12","r":"3.2"}],["$","path",null,{"d":"M12 3v2.4M12 18.6V21M21 12h-2.4M5.4 12H3M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3 5.6 5.6"}]]}]," How it runs"]}],["$","h2",null,{"style":{"color":"var(--ib-cyan)"},"children":"Carbon"}]]}],["$","div",null,{"className":"ib-reveal","children":["$","div",null,{"className":"ib-fc","children":[["$","div",null,{"className":"ib-fc-bar","children":[["$","span",null,{"children":"Carbon - PO to disclosure"}],["$","span",null,{"className":"live","children":[["$","i",null,{}],"LIVE"]}]]}],["$","div",null,{"className":"ib-fc-canvas","children":["$","svg",null,{"viewBox":"0 0 1000 318","role":"img","aria-label":"Carbon - PO to disclosure","children":[["$","defs",null,{"children":["$","marker",null,{"id":"ib-arrow","markerWidth":"9","markerHeight":"9","refX":"7","refY":"4.5","orient":"auto","markerUnits":"userSpaceOnUse","children":["$","path",null,{"d":"