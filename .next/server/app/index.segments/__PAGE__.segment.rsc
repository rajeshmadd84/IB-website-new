f:["$","section",null,{"className":"ib-sec alt","children":["$","div",null,{"className":"ib-wrap","children":[["$","div",null,{"className":"ib-head ib-reveal","children":[["$","span",null,{"className":"ib-eyebrow","children":[["$","svg",null,{"width":22,"height":22,"viewBox":"0 0 24 24","fill":"none","strokeWidth":1.6,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","circle",null,{"cx":"12","cy":"12","r":"9"}],["$","path",null,{"d":"M9.5 9.2a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.5v.3"}],["$","path",null,{"d":"M12 17h.01"}]]}]," FAQs"]}],["$","h2",null,{"children":"Know more about IntelliByld"}]]}],["$","div",null,{"className":"ib-faq ib-reveal","children":[["$","details","0",{"open":true,"children":[["$","summary",null,{"children":"What is IntelliByld?"}],["$","p",null,{"children":"IntelliByld is an AI-powered supply-chain platform built specifically for construction. It works as an operating system that automates material tracking, procurement, and logistics, keeping projects on time and reducing carbon footprints."}]]}],["$","details","1",{"open":false,"children":[["$","summary",null,{"children":"How does IntelliByld work?"}],["$","p",null,{"children":"It creates a dynamic Digital Twin of your supply chain, linking live material movements directly to your master project schedule. AI agents then manage RFQs, evaluate bids, and track shipments in real time."}]]}],["$","details","2",{"open":false,"children":[["$","summary",null,{"children":"What software does IntelliByld integrate with?"}],["$","p",null,{"children":"It works with BIM tools (IFC, Revit, Navisworks) and ERP platforms (SAP, Oracle, Procore), acting as an intelligent coordination layer across them. Pilots begin from your BOMs so no manual data entry required to start."}]]}],["$","details","3",{"open":false,"children":[["$","summary",null,{"children":"Is IntelliByld relevant outside Singapore?"}],["$","p",null,{"children":"Yes. It's aligned with Singapore's BCA Site Management Data Standards and IDD framework, which makes it a natural fit for Singapore GCs and developers. But the core capabilities (digital twin, agentic AI, supply-chain orchestration) apply to any large-scale project globally. The compliance layer is configurable per jurisdiction."}]]}],["$","details","4",{"open":false,"children":[["$","summary",null,{"children":"What does Autonomous Execution mean in construction logistics?"}],["$","p",null,{"children":"It means the supply chain takes corrective action without human instruction. If a steel shipment slips three days, the agents assess the schedule impact, contact alternative suppliers, generate and send RFQs, evaluate bids, and update the twin automatically. Your team is notified of the outcome, not asked to start the process."}]]}],["$","details","5",{"open":false,"children":[["$","summary",null,{"children":"How does IntelliByld handle carbon tracking?"}],["$","p",null,{"children":"It tracks embodied-carbon emissions from material deliveries in real time, based on actual delivery data rather than estimates. Each movement is logged with its footprint and reports generate automatically, supporting sustainability reporting and green-building requirements."}]]}]]}]]}]}]
